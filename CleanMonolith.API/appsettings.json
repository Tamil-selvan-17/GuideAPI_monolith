{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CleanMonolithDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Secret": "SuperSecretKeyForJwtAuthenticationWhichShouldBeVeryLongToBeSecure",
    "Issuer": "CleanMonolithApi",
    "Audience": "CleanMonolithClients",
    "ExpiryMinutes": 60
  }
}
